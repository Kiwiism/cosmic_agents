{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-journey-report-v1",
  "title": "Agent Journey Cohort Report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "status",
    "startedAtMs",
    "finishedAtMs",
    "targetLevel",
    "participantCount",
    "succeeded",
    "failed",
    "droppedSamples",
    "agents",
    "quests",
    "maps",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["RUNNING", "COMPLETED", "STOPPED"] },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "finishedAtMs": { "type": "integer", "minimum": 0 },
    "targetLevel": { "type": "integer", "minimum": 1 },
    "participantCount": { "type": "integer", "minimum": 0 },
    "succeeded": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "droppedSamples": { "type": "integer", "minimum": 0 },
    "agents": { "type": "array", "items": { "type": "object" } },
    "quests": { "type": "array", "items": { "type": "object" } },
    "maps": { "type": "array", "items": { "type": "object" } },
    "resources": { "type": "array", "items": { "type": "object" } },
    "agentsCsv": { "type": "string" },
    "questsCsv": { "type": "string" },
    "mapsCsv": { "type": "string" },
    "resourcesCsv": { "type": "string" },
    "markdown": { "type": "string" }
  }
}
