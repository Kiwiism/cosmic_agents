{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-journey-manifest-v1",
  "title": "Agent Journey Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "simulationMode",
    "startedAtMs",
    "targetLevel",
    "participants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "simulationMode": { "enum": ["off", "light", "full"] },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "targetLevel": { "type": "integer", "minimum": 1 },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characterId", "characterName", "career"],
        "properties": {
          "characterId": { "type": "integer", "minimum": 1 },
          "characterName": { "type": "string" },
          "career": { "type": "string" }
        }
      }
    }
  }
}
